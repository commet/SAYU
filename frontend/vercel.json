{
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps --ignore-scripts --include=dev",
  "buildCommand": "next build",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "github": {
    "silent": true
  }
}
