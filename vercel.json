{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps && ln -sf ../node_modules frontend/node_modules",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "github": {
    "silent": true
  }
}
