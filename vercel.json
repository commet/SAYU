{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps && npm install typescript @types/react @types/node --workspace=frontend --legacy-peer-deps",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "github": {
    "silent": true
  }
}
