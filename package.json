{
  "name": "sayu-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:shared && echo 'Build completed'",
    "build:shared": "npm run build --workspace=@sayu/shared",
    "start": "cd backend && node sayu-living-server.js",
    "typecheck": "cd frontend && npm exec -- tsc --noEmit",
    "typecheck:watch": "cd frontend && npx tsc --noEmit --watch",
    "lint": "cd frontend && npm run lint",
    "test": "cd backend && npm test",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:shared": "npm run dev --workspace=@sayu/shared",
    "health-check": "npm run typecheck && npm run lint && npm run test",
    "seed:exhibition-artworks": "npx tsx scripts/insert-exhibition-sample-data.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@playwright/mcp": "^0.0.32",
    "@supabase/supabase-js": "^2.55.0",
    "axios": "^1.12.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "groq-sdk": "^0.32.0",
    "pm2": "^6.0.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@railway/cli": "^4.5.3",
    "conventional-changelog-cli": "^5.0.0",
    "typescript": "^5.3.3"
  }
}
